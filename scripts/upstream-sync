def run_git(*args: str, cwd: Path | None = None, check: bool = True) -> str:
    completed = subprocess.run(
        ["git", *args],
        cwd=str(cwd) if cwd else None,
        check=check,
        text=True,
        capture_output=True,
        env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
    )
    return completed.stdout.strip()


def git_ok(*args: str, cwd: Path | None = None) -> bool:
    """Run git and report success; for probes where failure is meaningful."""
    return subprocess.run(
        ["git", *args],
        cwd=str(cwd) if cwd else None,
        capture_output=True,
        text=True,
        env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
    ).returncode == 0


def parse_tag_version(tag: str) -> tuple[int, ...] | None:
    """Parse a v-prefixed release tag into a comparable integer tuple."""
    text = str(tag or "").strip()
    if not text.startswith("v"):
        return None
    try:
        return tuple(int(part) for part in text[1:].split("."))
    except ValueError:
        return None


def rewrite_upstream_metadata(text: str, tag: str, commit: str) -> str:
    """Rewrite the [upstream] tag/commit.

    Only the [upstream] table changes; the [distribution] and [selfupdate]
    tables are preserved byte-for-byte.
    """
    lines = []
    in_upstream = False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("["):
            in_upstream = stripped == "[upstream]"
        if in_upstream and stripped.startswith("tag"):
            line = f'tag = "{tag}"'
        elif in_upstream and stripped.startswith("commit"):
            line = f'commit = "{commit}"'
        lines.append(line)
    return "\n".join(lines) + "\n"


def replace_identity_example(text: str, prefix: str, identity: str) -> str:
    """Refresh the e.g. release-identity example in the header comment."""
    import re

    pattern = rf"e\.g\. {re.escape(prefix)}v[\d.]+\.\d+"
    return re.sub(pattern, f"e.g. {identity}", text, count=1)


def validate_promotion_state(tag: str, state_dir: Path, worktree: Path) -> dict:
    """Check the completed replay evidence before moving the recorded base."""
    state_file = state_dir / "state.json"
    if not state_file.exists():
        raise SystemExit(f"No replay state for {tag}; run prepare/resume first.")
    state = json.loads(state_file.read_text())
    if not state.get("completed"):
        raise SystemExit(f"Replay for {tag} is not completed; run resume first.")
    branch = state.get("branch") or f"a0s-replay-{tag.lstrip('v').replace('.', '-')}"
    worktree = Path(worktree)
    if not (worktree / ".git").exists():
        raise SystemExit(f"Replay worktree {worktree} is missing.")
    current_branch = run_git("rev-parse", "--abbrev-ref", "HEAD", cwd=worktree)
    if current_branch != branch:
        raise SystemExit(f"Replay worktree is on {current_branch}, expected {branch}.")
    if run_git("status", "--porcelain", "--untracked-files=no", cwd=worktree):
        raise SystemExit("Replay worktree is dirty; commit or clean it first.")
    head = run_git("rev-parse", "HEAD", cwd=worktree)
    return {"branch": branch, "head": head}


def load_metadata(path: Path = METADATA_FILE) -> dict:
    if not path.exists():
        raise SystemExit(f"Missing {path}; the canonical upstream metadata is required.")
    import tomllib

    with open(path, "rb") as handle:
        return tomllib.load(handle)


def upstream_ref(metadata: dict) -> dict:
    upstream = metadata["upstream"]
    return {
        "repository": upstream["repository"],
        "tag": upstream["tag"],
        "commit": upstream["commit"],
    }


def ensure_upstream_remote() -> None:
    remotes = run_git("remote")
    if UPSTREAM_REMOTE not in remotes.split():
        run_git("remote", "add", UPSTREAM_REMOTE, upstream_ref(load_metadata())["repository"])
    run_git("fetch", UPSTREAM_REMOTE, "--tags", "--prune", "--quiet")


def resolve_tag(tag: str) -> str:
    commit = run_git("rev-parse", "--verify", "--quiet", f"{tag}^{{commit}}")
    if not commit:
        raise SystemExit(f"Tag {tag} not found in {UPSTREAM_REMOTE}; run 'plan' to fetch upstream first.")
    return commit


def repo_head() -> str:
    return run_git("rev-parse", "HEAD")


def is_dirty() -> bool:
    return bool(run_git("status", "--porcelain", "--untracked-files=no"))


def changed_files(a: str, b: str) -> list[str]:
    return run_git("diff", "--name-only", a, b).splitlines()


def file_exists_in(ref: str, path: str) -> bool:
    probe = subprocess.run(
        ["git", "cat-file", "-e", f"{ref}:{path}", "--"],
        capture_output=True,
        text=True,
    )
    return probe.returncode == 0


def fork_delta_files(base: str, ref: str) -> tuple[list[str], list[str]]:
    """Return (modified existing, added) files between base and ref."""
    modified: list[str] = []
    added: list[str] = []
    for line in run_git("diff", "--name-status", base, ref).splitlines():
        status, _, path = line.partition("\t")
        if path.startswith("->"):
            path = path.split("-> ")[-1]
        if status.startswith("A"):
            added.append(path)
        else:
            modified.append(path)
    return modified, added


def delta_numstat(a: str, b: str) -> dict[str, tuple[int, int]]:
    result: dict[str, tuple[int, int]] = {}
    for line in run_git("diff", "--numstat", a, b).splitlines():
        added, removed, path = line.split("\t")
        result[path] = (int(added) if added != "-" else 0, int(removed) if removed else 0)
    return result


def classify_fork_delta(path: str, base: str) -> tuple[str, str]:
    override = CORE_PATCH_NOTES.get(path)
    if override:
        return override
    if not file_exists_in(base, path):
        for prefix, category in DIR_CATEGORIES:
            if path.startswith(prefix):
                return category, "Symbolics-owned addition"
        return "symbolic-runtime", "Symbolics-owned addition"
    return "unavoidable-core-patch", "modifies an upstream-owned file"


def latest_upstream_tag() -> str:
    tags = run_git("tag", "--sort=-v:refname").splitlines()
    return next((t for t in tags if t.startswith("v")), "")


def fork_surface(base: str | None, ref: str | None) -> dict:
    base = base or upstream_ref(load_metadata())["commit"]
    ref = ref or repo_head()
    modified, added = fork_delta_files(base, ref)
    upstream_current = resolve_tag(latest_upstream_tag()) if latest_upstream_tag() else ""
    upstream_modified, upstream_added = fork_delta_files(base, upstream_current) if upstream_current else ([], [])
    # Upstream-owned = vendor files that Symbolics modifies; upstream's own
    # delta from the recorded base marks the conflict-prone overlap.
    upstream_owned = sorted(p for p in modified if file_exists_in(base, p))
    upstream_overlap = sorted(set(upstream_owned) & (set(upstream_modified) | set(upstream_added)))
    numstat = delta_numstat(base, ref)
    entries = []
    counts: dict[str, int] = {}
    loc = 0
    for path in sorted(set(modified) | set(added)):
        klass, note = classify_fork_delta(path, base)
        added_loc, removed_loc = numstat.get(path, (0, 0))
        counts[klass] = counts.get(klass, 0) + 1
        if klass in ("unavoidable-core-patch", "compatibility-hook"):
            loc += added_loc + removed_loc
        entries.append({"path": path, "class": klass, "note": note, "added": added_loc, "removed": removed_loc})
    return {
        "base": base,
        "ref": ref,
        "files_changed": len(entries),
        "files_added": len(added),
        "upstream_owned_modified": len(upstream_owned),
        "upstream_owned_files": upstream_owned,
        "loc_added": sum(v[0] for v in numstat.values()),
        "loc_removed": sum(v[1] for v in numstat.values()),
        "core_patch_loc": loc,
        "core_patches": counts.get("unavoidable-core-patch", 0),
        "hotspots": [p for p in upstream_owned if p in HOTSPOT_FILES],
        "counts": counts,
        "entries": entries,
    }


HOTSPOT_FILES = {
    "agent.py",
    "models.py",
    "helpers/extract_tools.py",
    "helpers/litellm_transport.py",
    "helpers/self_update.py",
    "helpers/state_snapshot.py",
    "conf/model_providers.yaml",
    "webui/js/messages.js",
}


def write_fork_surface_toml(surface: dict) -> str:
    lines = [
        "# Generated by scripts/upstream-sync fork-surface. Do not edit by hand.",
        f'# base = "{surface["base"]}"',
        f'# ref = "{surface["ref"]}"',
        "",
        "[summary]",
        f'files_changed = {surface["files_changed"]}',
        f'upstream_owned_modified = {surface["upstream_owned_modified"]}',
        f'loc_added = {surface["loc_added"]}',
        f'loc_removed = {surface["loc_removed"]}',
        f'core_patch_loc = {surface["core_patch_loc"]}',
        f'core_patches = {surface["core_patches"]}',
        f'hotspots = {json.dumps(surface["hotspots"])}',
        "",
        "[counts]",
    ]
    for klass, count in sorted(surface["counts"].items()):
        lines.append(f'{klass} = {count}')
    lines.append("")
    lines.append("[upstream_owned_files]")
    for path in surface["upstream_owned_files"]:
        entry = next(e for e in surface["entries"] if e["path"] == path)
        note = entry["note"].replace('"', "'")
        lines.append(f'"{path}" = {{ class = "{entry["class"]}", note = "{note}" }}')
    return "\n".join(lines) + "\n"


def cmd_fork_surface(args: argparse.Namespace) -> None:
    surface = fork_surface(args.base, args.ref)
    output = write_fork_surface_toml(surface)
    if args.write:
        FORK_SURFACE_FILE.write_text(output, encoding="utf-8")
        print(f"wrote {FORK_SURFACE_FILE}")
    print(json.dumps({k: v for k, v in surface.items() if k != "entries"}, indent=2))


def apply_promotion(worktree: Path, tag: str, new_commit: str, old_commit: str,
                    meta: dict, checks: dict, state_dir: Path) -> dict:
    """Rewrite metadata + fork surface on the replay branch and commit it."""
    head = checks["head"]
    worktree_metadata = worktree / "maint" / "upstream.toml"
    if load_metadata(worktree_metadata)["upstream"]["commit"] != old_commit:
        raise SystemExit("Replay worktree metadata does not match the recorded base; out of sync.")
    series = int(meta.get("distribution", {}).get("series", 0))
    prefix = str(meta.get("distribution", {}).get("release_prefix", "a0s-"))
    text = worktree_metadata.read_text(encoding="utf-8")
    updated = replace_identity_example(
        rewrite_upstream_metadata(text, tag, new_commit),
        prefix,
        f"{prefix}{tag}.{series}",
    )
    worktree_metadata.write_text(updated, encoding="utf-8")
    surface = fork_surface(new_commit, head)
    (worktree / "maint" / "fork-surface.toml").write_text(
        write_fork_surface_toml(surface), encoding="utf-8"
    )
    summary = {
        "old_base": {"tag": meta["upstream"]["tag"], "commit": old_commit},
        "new_base": {"tag": tag, "commit": new_commit},
        "replay_branch": checks["branch"],
        "replay_head": head,
        "fork_surface": {
            key: surface[key]
            for key in ("base", "ref", "files_changed", "files_added",
                        "upstream_owned_modified", "loc_added", "loc_removed",
                        "core_patch_loc", "core_patches")
        },
    }
    promotion_report = state_dir / "promotion.json"
    promotion_report.write_text(json.dumps(summary, indent=2) + "\n")
    run_git("add", "maint/upstream.toml", "maint/fork-surface.toml", cwd=worktree)
    run_git("add", str(promotion_report.relative_to(REPO_ROOT)), cwd=worktree)
    run_git(
        "commit", "-q",
        "-m", f"feat(maint): promote canonical upstream base to {tag} ({new_commit[:12]})",
        cwd=worktree,
    )
    summary["promotion_commit"] = run_git("rev-parse", "HEAD", cwd=worktree)
    return summary


def cmd_promote(args: argparse.Namespace) -> None:
    """Move the canonical upstream base to a completed, verified replay head."""
    meta = load_metadata()
    base = upstream_ref(meta)
    old_tag, old_commit = base["tag"], base["commit"]
    new_commit = resolve_tag(args.tag)
    old_v, new_v = parse_tag_version(old_tag), parse_tag_version(args.tag)
    if old_v is None or new_v is None:
        raise SystemExit(f"Cannot compare recorded base {old_tag!r} with {args.tag!r}.")
    if new_commit == old_commit:
        print(f"already promoted: base is {old_tag} {old_commit[:12]}")
        return
    if new_v < old_v:
        raise SystemExit(f"Refusing to move the recorded base backwards: {old_tag} -> {args.tag}.")
    if is_dirty():
        raise SystemExit("Primary worktree is dirty; promotion requires a clean checkout.")
    worktree = Path(args.repo) if args.repo else REPO_ROOT / "tmp" / "upstream-replay" / args.tag
    state_dir = REPO_ROOT / "maint" / "reports" / f"prepare-{args.tag}"
    checks = validate_promotion_state(args.tag, state_dir, worktree)
    head = checks["head"]
    if not git_ok("merge-base", "--is-ancestor", new_commit, head, cwd=worktree):
        raise SystemExit(
            f"Replay head {head[:12]} does not contain {args.tag} {new_commit[:12]}; promotion refused."
        )
    summary = apply_promotion(worktree, args.tag, new_commit, old_commit, meta, checks, state_dir)
    print(json.dumps(summary, indent=2))
    print(f"\npromotion commit: {summary['promotion_commit'][:12]} on {checks['branch']}")
    print("next: run the release gates on this branch, then open the promotion PR")


def cmd_status(args: argparse.Namespace) -> None:
    meta = load_metadata()
    base = upstream_ref(meta)
    ensure_upstream_remote()
    tags = run_git("tag", "--sort=-v:refname").splitlines()
    latest = next((t for t in tags if t.startswith("v")), "")
    latest_commit = resolve_tag(latest) if latest else ""
    head = repo_head()
    sym_modified, sym_added = fork_delta_files(base["commit"], head)
    print(
        json.dumps(
            {
                "base_tag": base["tag"],
                "base_commit": base["commit"],
                "head": head,
                "latest_upstream_tag": latest,
                "latest_upstream_commit": latest_commit,
                "upstream_commits_since_base": int(run_git("rev-list", "--count", f"{base['commit']}..{latest_commit}") or 0) if latest_commit else 0,
                "fork_delta_files": len(sym_modified) + len(sym_added),
                "dirty": is_dirty(),
            },
            indent=2,
        )
    )


def cmd_plan(args: argparse.Namespace) -> None:
    meta = load_metadata()
    base = upstream_ref(meta)
    ensure_upstream_remote()
    new_commit = resolve_tag(args.tag)
    upstream_delta = run_git("diff", "--name-status", base["commit"], new_commit).splitlines()
    sym_modified, sym_added = fork_delta_files(base["commit"], repo_head())
    upstream_files = {line.split("\t")[-1].split("-> ")[-1] for line in upstream_delta}
    overlap = sorted(set(sym_modified) & upstream_files)
    conflicts_preview = [p for p in overlap if p in HOTSPOT_FILES]
    report = {
        "old_base": {"tag": base["tag"], "commit": base["commit"]},
        "new_base": {"tag": args.tag, "commit": new_commit},
        "upstream_changed_files": len(upstream_files),
        "symbolics_modified_files": len(sym_modified),
        "overlapping_files": overlap,
        "likely_conflict_hotspots": conflicts_preview,
        "upstream_commits": run_git("rev-list", "--count", f"{base['commit']}..{new_commit}"),
    }
    REPORTS_DIR.mkdir(parents=True, exist_ok=True)
    out = REPORTS_DIR / f"plan-{args.tag}.json"
    out.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(report, indent=2))
    print(f"\nreport: {out}")


def prepare_worktree(tag: str, new_commit: str, dir_path: Path) -> tuple[Path, str]:
    if dir_path.exists() and (dir_path / ".git").exists():
        existing = run_git("rev-parse", "--abbrev-ref", "HEAD", cwd=dir_path)
        print(f"reusing existing replay worktree {dir_path} on {existing}")
        return dir_path, existing
    if dir_path.exists():
        raise SystemExit(f"{dir_path} exists but is not a git worktree; remove it first.")
    dir_path.parent.mkdir(parents=True, exist_ok=True)
    run_git("worktree", "add", "--detach", str(dir_path), new_commit)
    branch = f"a0s-replay-{tag.lstrip('v').replace('.', '-')}"
    run_git("checkout", "-b", branch, "--quiet", cwd=dir_path)
    # rerere records recurring conflict resolutions; reuse stays reviewable.
    run_git("config", "rerere.enabled", "true", cwd=dir_path)
    return dir_path, branch


def series_commits(base: str, head: str) -> list[str]:
    return run_git("rev-list", "--reverse", "--no-merges", f"{base}..{head}").splitlines()


def conflict_report(worktree: Path, tag: str, sha: str, state_dir: Path) -> Path:
    conflicted = run_git("diff", "--name-only", "--diff-filter=U", cwd=worktree).splitlines()
    lines = [f"# Upstream replay conflicts: {tag} at {sha[:12]}", ""]
    notes = RESOLUTIONS_DIR / tag
    if notes.exists():
        lines.append(f"Recorded resolutions: {notes} (apply, verify, then commit)")
        lines.append("")
    for path in conflicted:
        lines.append(f"## {path}")
        lines.append("```")
        lines.append(run_git("diff", "--", path, cwd=worktree))
        lines.append("```")
        lines.append("")
    out = state_dir / f"conflicts-{sha[:12]}.md"
    out.write_text("\n".join(lines), encoding="utf-8")
    return out


def replay_series(worktree: Path, commits: list[str], tag: str, state_dir: Path) -> tuple[bool, list[str]]:
    state_file = state_dir / "state.json"
    done: list[str] = []
    if state_file.exists():
        done = json.loads(state_file.read_text()).get("replayed", [])
    # Trust the worktree log over the state file: manual resolutions outside
    # this tool still count as replayed.
    try:
        bodies = run_git("log", "--format=%B", f"{tag}^{{commit}}..HEAD", cwd=worktree)
        for line in bodies.splitlines():
            line = line.strip()
            if line.startswith("(cherry picked from commit ") and line.endswith(")"):
                done.append(line[len("(cherry picked from commit "):-1].strip())
    except Exception:
        pass
    remaining = [c for c in commits if c not in set(done)]
    replayed: list[str] = list(done)
    skipped: list[str] = []
    for sha in remaining:
        pick_state = Path(run_git("rev-parse", "--git-dir", cwd=worktree)) / "CHERRY_PICK_HEAD"
        if pick_state.exists():
            print(f"A cherry-pick is already in progress in {worktree}; resolve it first.")
            return False, replayed
        result = subprocess.run(
            ["git", "cherry-pick", "-x", sha],
            cwd=str(worktree),
            text=True,
            capture_output=True,
        )
        if result.returncode == 0:
            replayed.append(sha)
            state_file.write_text(
                json.dumps({"replayed": replayed, "tag": tag, "worktree": str(worktree)}, indent=1)
            )
            continue
        combined = (result.stdout or "") + (result.stderr or "")
        if "now empty" in combined:
            subprocess.run(
                ["git", "cherry-pick", "--skip"],
                cwd=str(worktree),
                capture_output=True,
            )
            skipped.append(sha)
            state_file.write_text(
                json.dumps(
                    {"replayed": replayed, "skipped": skipped, "tag": tag, "worktree": str(worktree)},
                    indent=1,
                )
            )
            print(f"skipped empty pick {sha[:12]} (content already present upstream or in overlay)")
            continue
        report = conflict_report(worktree, tag, sha, state_dir)
        state_file.write_text(
            json.dumps(
                {"replayed": replayed, "tag": tag, "worktree": str(worktree), "stopped_at": sha},
                indent=1,
            )
        )
        print(f"CONFLICT replaying {sha[:12]}: {run_git('log', '-1', '--format=%s', sha)}")
        print(f"conflict report: {report}")
        print("resolve in the worktree, commit, then re-run: scripts/upstream-sync resume")
        return False, replayed
    return True, replayed


def cmd_prepare(args: argparse.Namespace) -> None:
    if is_dirty():
        raise SystemExit("Primary worktree is dirty; upstream replay requires a clean checkout.")
    meta = load_metadata()
    base = upstream_ref(meta)
    ensure_upstream_remote()
    new_commit = resolve_tag(args.tag)
    head = repo_head()
    dir_path = Path(args.dir) if args.dir else REPO_ROOT / "tmp" / "upstream-replay" / args.tag
    worktree, branch = prepare_worktree(args.tag, new_commit, dir_path)
    commits = series_commits(base["commit"], head)
    state_dir = MAINT_DIR / "reports" / f"prepare-{args.tag}"
    state_dir.mkdir(parents=True, exist_ok=True)
    if args.squash:
        patch = run_git("diff", base["commit"], head)
        result = subprocess.run(
            ["git", "apply", "--3way", "--index", "-"],
            cwd=str(worktree),
            input=patch,
            text=True,
            capture_output=True,
        )
        if result.returncode != 0:
            print(f"squash apply failed ({result.returncode}); worktree {worktree}")
            report = conflict_report(worktree, args.tag, "squash", state_dir)
            print(f"conflict report: {report}")
            return
        run_git("commit", "-m", f"Squashed Symbolics overlay replayed onto {args.tag} ({new_commit[:12]})",
                "-q", cwd=worktree)
        done = True
        replayed = ["squash"]
        (state_dir / "state.json").write_text(
            json.dumps({"replayed": replayed, "tag": args.tag, "worktree": str(worktree), "completed": True}, indent=1)
        )
    else:
        done, replayed = replay_series(worktree, commits, args.tag, state_dir)
        if not done:
            return
    range_diff = run_git(
        "range-diff",
        f"{base['commit']}..{head}",
        f"{new_commit}..{branch}",
        cwd=REPO_ROOT,
    )
    report = {
        "old_base": base,
        "new_base": {"tag": args.tag, "commit": new_commit},
        "worktree": str(worktree),
        "branch": branch,
        "replayed": replayed,
        "series_commits": len(commits),
        "range_diff_lines": len(range_diff.splitlines()),
    }
    (state_dir / "replay-report.json").write_text(json.dumps(report, indent=2) + "\n")
    (state_dir / "range-diff.txt").write_text(range_diff + "\n")
    print(json.dumps(report, indent=2))
    print(f"\nnext: scripts/upstream-sync verify --repo {worktree}")


def cmd_resume(args: argparse.Namespace) -> None:
    meta = load_metadata()
    base = upstream_ref(meta)
    head = repo_head()
    state_file = MAINT_DIR / "reports" / f"prepare-{args.tag}" / "state.json"
    if not state_file.exists():
        raise SystemExit(f"No replay state for {args.tag}; run prepare first.")
    state = json.loads(state_file.read_text())
    worktree = Path(args.repo) if args.repo else Path(state["worktree"])
    commits = series_commits(base["commit"], head)
    done, replayed = replay_series(worktree, commits, args.tag, state_file.parent)
    if not done:
        return
    branch = run_git("rev-parse", "--abbrev-ref", "HEAD", cwd=worktree)
    new_commit = run_git("rev-parse", f"{args.tag}^{{commit}}")
    range_diff = run_git("range-diff", f"{base['commit']}..{head}", f"{new_commit}..{branch}", cwd=REPO_ROOT)
    (state_file.parent / "range-diff.txt").write_text(range_diff + "\n")
    state.update({"replayed": replayed, "completed": True, "branch": branch})
    state_file.write_text(json.dumps(state, indent=1))
    print(f"replay complete in {worktree} on {branch}")


def cmd_verify(args: argparse.Namespace) -> None:
    repo = Path(args.repo).resolve() if args.repo else REPO_ROOT
    results: dict[str, dict] = {}
    test_set = [t for t in VERIFY_TEST_SET if (repo / t).exists()]
    pytest_run = subprocess.run(
        [sys.executable, "-m", "pytest", *test_set, "-q", "--no-header"],
        cwd=str(repo),
        text=True,
        capture_output=True,
    )
    results["pytest"] = {
        "exit": pytest_run.returncode,
        "tail": pytest_run.stdout.strip().splitlines()[-12:],
    }
    import_smoke = subprocess.run(
        [sys.executable, "-c",
         "import agent, models, helpers.self_update, helpers.symbolics_release; print('imports ok')"],
        cwd=str(repo),
        text=True,
        capture_output=True,
    )
    results["import_smoke"] = {"exit": import_smoke.returncode, "output": import_smoke.stdout.strip() or import_smoke.stderr.strip()[-400:]}
    plugin_probe = subprocess.run(
        [sys.executable, "-c",
         "from helpers import plugins; names = plugins.get_plugins_list(); assert '_a0s_prompts' in names and '_prolog_rlm' in names; print('plugins ok')"],
        cwd=str(repo),
        text=True,
        capture_output=True,
    )
    results["plugins"] = {"exit": plugin_probe.returncode, "output": plugin_probe.stdout.strip() or plugin_probe.stderr.strip()[-400:]}
    prolog = subprocess.run(["swipl", "--version"], capture_output=True, text=True)
    results["prolog_runtime"] = {"exit": prolog.returncode, "available": prolog.returncode == 0}
    if args.full:
        docker_available = shutil.which("docker") is not None
        if docker_available:
            compose = subprocess.run(
                ["docker", "compose", "--project-name", "a0s-verify", "-f", "docker/symbolics/compose.yml.example", "config", "--quiet"],
                cwd=str(repo), text=True, capture_output=True,
            )
            results["docker_compose"] = {"exit": compose.returncode, "error": compose.stderr.strip()[-300:]}
        else:
            results["docker_compose"] = {"exit": -1, "error": "docker not available"}
        nix_available = shutil.which("nix") is not None
        if nix_available:
            nix = subprocess.run(["nix", "flake", "metadata", "--json"], cwd=str(repo), text=True, capture_output=True)
            results["nix_flake"] = {"exit": nix.returncode, "error": nix.stderr.strip()[-300:]}
        else:
            results["nix_flake"] = {"exit": -1, "error": "nix not available"}
    ok = all(v.get("exit", 1) == 0 for k, v in results.items() if k not in ("prolog_runtime",))
    results["passed"] = ok
    print(json.dumps(results, indent=2))
    sys.exit(0 if ok else 1)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("status", help="show base, HEAD, and latest upstream state")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("plan", help="resolve a tag and report the upstream delta and overlap")
    p.add_argument("tag")
    p.set_defaults(func=cmd_plan)

    p = sub.add_parser("prepare", help="replay the Symbolics series onto a new upstream base in an isolated worktree")
    p.add_argument("tag")
    p.add_argument("--dir", default="", help="worktree location (default tmp/upstream-replay/<tag>)")
    p.add_argument("--squash", action="store_true", help="replay the whole overlay as one squashed commit")
    p.set_defaults(func=cmd_prepare)

    p = sub.add_parser("resume", help="continue a conflicted replay after resolutions are committed")
    p.add_argument("tag")
    p.add_argument("--repo", default="", help="worktree path if not the default")
    p.set_defaults(func=cmd_resume)

    p = sub.add_parser("verify", help="run compatibility gates in a checkout")
    p.add_argument("--repo", default="", help="checkout to verify (default: this repo)")
    p.add_argument("--full", action="store_true", help="also run docker compose and nix checks when available")
    p.set_defaults(func=cmd_verify)

    p = sub.add_parser("fork-surface", help="measure and classify the fork surface against the base")
    p.add_argument("--base", default="")
    p.add_argument("--ref", default="")
    p.add_argument("--write", action="store_true", help="write maint/fork-surface.toml")
    p.set_defaults(func=cmd_fork_surface)

    p = sub.add_parser("promote", help="move the canonical upstream base to a completed replay head")
    p.add_argument("tag")
    p.add_argument("--repo", default="", help="replay worktree path (default: tmp/upstream-replay/<tag>)")
    p.set_defaults(func=cmd_promote)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()