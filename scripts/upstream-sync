    "tests/test_self_update_tag_filter.py",
    "tests/test_self_update_runtime_sync.py",
    "tests/test_responses_architecture.py",
    "tests/test_tool_choice_drop_retry.py",
    "tests/test_default_prompt_budget.py",
    "tests/test_context_debloat_defaults.py",
    "tests/test_defer_lifecycle.py",
    "tests/test_task_scheduler_runs.py",
    "tests/test_prolog_rlm_pin.py",
    "tests/test_http_auth_csrf.py",
]

