# Copy this file to compose.yml and customize it for the local machine.
# compose.yml is intentionally gitignored so host-specific mounts, ports, devices,
# environment settings, and other local overrides survive repository updates.
services:
  agent-zero:
    container_name: agent-zero
    image: a0-symbolics:local
    build:
      context: ../..
      dockerfile: DockerfileLocal
      args:
        BRANCH: local
    restart: unless-stopped
    mem_limit: 8g
    memswap_limit: 8g
    environment:
      PROLOG_RLM_ENABLED: "${PROLOG_RLM_ENABLED:-1}"
      PROLOG_RLM_ROOT: ""
      OPENROUTER_API_KEY: "${OPENROUTER_API_KEY:-}"
      OPENROUTER_MODEL: "${OPENROUTER_MODEL:-openrouter/auto}"
      EXTENSIONS_LOG: "${EXTENSIONS_LOG:-0}"
    ports:
      - "50080:80"
    volumes:
      - a0-symbolics-nix:/nix
      - a0-symbolics-usr:/a0/usr
    ulimits:
      nofile:
        soft: 65535
        hard: 65535
    extra_hosts:
      - "host.docker.internal:host-gateway"
    healthcheck:
      test: ["CMD", "/opt/a0-symbolics/healthcheck.sh"]
      interval: 10s
      timeout: 6s
      retries: 30
      start_period: 10m

volumes:
  a0-symbolics-nix:
    name: a0-symbolics-nix
  a0-symbolics-usr:
    name: a0-symbolics-usr
