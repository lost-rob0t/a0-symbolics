# Use the pre-built base image for A0
# FROM agent-zero-base:local
FROM agent0ai/agent-zero-base:latest

# Set BRANCH to "local" if not provided
ARG BRANCH=local
ENV BRANCH=$BRANCH
ENV NIX_REMOTE=local
ENV PATH="/root/.nix-profile/bin:${PATH}"

# Copy filesystem files to root
COPY ./docker/run/fs/ /
# Copy current development files to git, they will only be used in "local" branch
COPY ./ /git/agent-zero
# The Docker context excludes mutable user state, but preload expects this root.
RUN mkdir -p /git/agent-zero/usr/plugins

# pre installation steps
RUN bash /ins/pre_install.sh $BRANCH

# install A0
RUN bash /ins/install_A0.sh $BRANCH

# install additional software
RUN bash /ins/install_additional.sh $BRANCH

# Keep the Nix binary image-owned while /nix itself can be a persistent volume.
# Install it only after the pinned desktop transaction so the rolling package
# cannot upgrade core libraries before install_additional switches suites.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nix-bin \
    && mkdir -p /etc/nix /nix/store /nix/var/nix/profiles/per-user/root /nix/var/nix/gcroots/per-user/root \
    && printf '%s\n' \
        'experimental-features = nix-command flakes' \
        'sandbox = false' \
        'build-users-group =' \
        > /etc/nix/nix.conf \
    && nix-store --init \
    && rm -rf /var/lib/apt/lists/*

# cleanup repo and install A0 without caching, this speeds up builds
ARG CACHE_DATE=none
RUN echo "cache buster $CACHE_DATE" && bash /ins/install_A02.sh $BRANCH

# post installation steps
RUN bash /ins/post_install.sh $BRANCH

# Add the thin local wrapper and reusable Home Manager seed after A0 installation.
COPY ./docker/symbolics/ /opt/a0-symbolics/

# Expose ports
EXPOSE 22 80 9000-9009

RUN chmod +x \
    /exe/initialize.sh \
    /exe/run_A0.sh \
    /exe/run_searxng.sh \
    /exe/run_tunnel_api.sh \
    /opt/a0-symbolics/initialize.sh

# Prepare persistent Nix/Home Manager state, then hand off to normal A0 startup.
CMD ["/opt/a0-symbolics/initialize.sh"]
